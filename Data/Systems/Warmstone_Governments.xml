	</ModifierArguments>
	<GovernmentModifiers>
		<Row GovernmentType="GOVERNMENT_WARMSTONE_COMPACT"><ModifierId>WARMSTONE_COMPACT_ENVOYS</ModifierId></Row>
		<Row GovernmentType="GOVERNMENT_WARMSTONE_COMPACT"><ModifierId>WARMSTONE_COMPACT_TRADE_ROUTES</ModifierId></Row>
		<Row GovernmentType="GOVERNMENT_WARMSTONE_SOFT_WAR"><ModifierId>WARMSTONE_SOFT_WAR_PRODUCTION</ModifierId></Row>
		<Row GovernmentType="GOVERNMENT_WARMSTONE_SOFT_WAR"><ModifierId>WARMSTONE_SOFT_WAR_DEFENSIVE_PRODUCTION</ModifierId></Row>
	</GovernmentModifiers>
</GameInfo>
