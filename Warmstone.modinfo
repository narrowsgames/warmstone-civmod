<?xml version="1.0" encoding="utf-8"?>
<!--
  Action wiring rules for this mod (learned the hard way - see
  Data/Systems/Warmstone_HideVanillaLeaders_Config.xml for the full diagnosis):

  * A file that touches Configuration-database tables (Players, PlayerItems, ...)
    belongs in FrontEndActions ONLY.
  * A file that touches Gameplay-database tables (Civilizations, Leaders,
    CivilizationLeaders, Units, Improvements, ...) belongs in InGameActions ONLY.
  * Never load one file into both. Each database only has its own tables, so a
    mixed file aborts on "no such table" in whichever pass lacks it - and the
    abort skips the rest of that file AND every later action from this mod.

  LoadOrder: DLC config/gameplay data loads at the default (0). Anything that
  deletes vanilla rows must therefore run at a HIGHER LoadOrder than the DLC, or
  the expansions simply repopulate the table afterwards. Hence 100 for the
  hide-vanilla-leaders pass, and 110+ for each Warmstone civ so its own rows are
  added after that delete rather than being caught by it.
-->
<Mod id="644637f8-7e68-4428-9dc3-a3ef0e9b8ee1" version="1">
	<Properties>
		<Name>WARMSTONE_MOD_TITLE</Name>
		<Description>WARMSTONE_MOD_DESCRIPTION</Description>
		<Teaser>WARMSTONE_MOD_TEASER</Teaser>
		<Authors>WARMSTONE_MOD_AUTHOR</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
	</Properties>
	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE"/>
	</Dependencies>
	<InGameActions>
		<UpdateDatabase id="Warmstone_Systems">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File priority="1">Data/Systems/Warmstone_Resources.xml</File>
			<File priority="2">Data/Systems/Warmstone_Terrain.xml</File>
			<File priority="3">Data/Systems/Warmstone_Governments.xml</File>
		</UpdateDatabase>
		<UpdateDatabase id="Warmstone_HideVanillaLeaders">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>Data/Systems/Warmstone_HideVanillaLeaders_Gameplay.xml</File>
		</UpdateDatabase>
		<UpdateDatabase id="Warmstone_Stalwarts">
			<Properties>
				<LoadOrder>110</LoadOrder>
			</Properties>
			<File priority="1">Data/Civilizations/Stalwarts/Stalwarts_Civilization.xml</File>
			<File priority="2">Data/Civilizations/Stalwarts/Stalwarts_Leaders.xml</File>
		</UpdateDatabase>
	</InGameActions>
	<FrontEndActions>
		<UpdateDatabase id="Warmstone_HideVanillaLeaders_FrontEnd">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>Data/Systems/Warmstone_HideVanillaLeaders_Config.xml</File>
		</UpdateDatabase>
		<UpdateDatabase id="Warmstone_Stalwarts_FrontEnd">
			<Properties>
				<LoadOrder>110</LoadOrder>
			</Properties>
			<File>Data/Civilizations/Stalwarts/Stalwarts_Config.xml</File>
		</UpdateDatabase>
	</FrontEndActions>
	<Files>
		<File>Data/Systems/Warmstone_Resources.xml</File>
		<File>Data/Systems/Warmstone_Terrain.xml</File>
		<File>Data/Systems/Warmstone_Governments.xml</File>
		<File>Data/Systems/Warmstone_HideVanillaLeaders_Config.xml</File>
		<File>Data/Systems/Warmstone_HideVanillaLeaders_Gameplay.xml</File>
		<File>Data/Civilizations/Stalwarts/Stalwarts_Civilization.xml</File>
		<File>Data/Civilizations/Stalwarts/Stalwarts_Leaders.xml</File>
		<File>Data/Civilizations/Stalwarts/Stalwarts_Config.xml</File>
	</Files>
</Mod>
